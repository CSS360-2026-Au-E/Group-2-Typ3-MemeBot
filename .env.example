# Copy this file to .env and fill in your own values. Never commit .env.

# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
TOKEN=your-discord-bot-token

# Text channel where the bot posts its welcome and ready messages
CHANNEL_NAME=general

# OpenAI API key, used by Whisper to transcribe voice (platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-key
